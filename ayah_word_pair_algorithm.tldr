      "meta": {},
      "props": {
        "geo": "rectangle",
        "dash": "solid",
        "url": "",
        "w": 820,
        "h": 370,
        "growY": 0,
        "scale": 1,
        "flipX": false,
        "flipY": false,
        "labelColor": "black",
        "color": "red",
        "fill": "solid",
        "size": "m",
        "font": "sans",
        "align": "middle",
        "verticalAlign": "middle",
        "richText": {
          "type": "doc",
          "content": [{ "type": "paragraph", "content": [{ "type": "text", "text": "Important implementation facts\nThe expected canonical text is passed into an internal prompt parameter but is not included in either Whisper command today.\nThe intended Arabic clitic unit path checks byte length == 1, so Arabic one-letter clitics normally do not enter that branch.\nLCS gap filling uses step=(gap/count+1) and starts at cursor+step; multiple misses can overshoot an anchor before later normalization.\nword_timing=whisper still falls back to even timing after warning." }] }]
        }
      }
    }
  ]
}
