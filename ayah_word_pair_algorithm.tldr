    {
      "id": "shape:pair-detail",
      "typeName": "shape",
      "type": "geo",
      "x": 1450,
      "y": 1170,
      "rotation": 0,
      "index": "acdcb",
      "parentId": "page:page",
      "isLocked": false,
      "opacity": 1,
      "meta": {},
      "props": {
